{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "openmolt": ["../../dist/index.d.ts"],
      "openmolt/*": ["../../dist/*"]
    }
  },
  "include": ["src/**/*"]
}
